{
  "manifest_version": 3,
  "name": "Branchy",
  "version": "1.0.0",
  "description": "Tree style tabs in the sidebar: a tab hangs under the one that opened it, tickets gather their merge requests, folders nest.",
  "permissions": ["tabs", "webNavigation", "storage", "tabGroups", "clipboardWrite", "alarms"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "sidebar_action": {
    "default_panel": "panel.html",
    "default_title": "Branchy",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
